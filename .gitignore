# Local runtime state, saves, credentials, diagnostics, broadcasts, and captures
/.stream-town/
/bevy-port/.stream-town/
/bevy-port/**/.stream-town/
*.stbevy
*.stbevy.bak*

# Rust, native dependencies, packages, and generated acceptance output
/bevy-port/target/
/bevy-port/generated/
/bevy-port/tests/generated/
/bevy-port/dist/
/bevy-port/vcpkg_installed/

# Converted runtime assets are allow-listed by distributable format. Conversion
# reports, source intermediates, and logs are intentionally not source inputs.
/bevy-port/assets/migrated/*
!/bevy-port/assets/migrated/models/
/bevy-port/assets/migrated/models/*
!/bevy-port/assets/migrated/models/**/
!/bevy-port/assets/migrated/models/**/*.glb
!/bevy-port/assets/migrated/fonts/
!/bevy-port/assets/migrated/fonts/*.ttf
!/bevy-port/assets/migrated/textures/
/bevy-port/assets/migrated/textures/*
!/bevy-port/assets/migrated/textures/**/
!/bevy-port/assets/migrated/textures/**/*.png
!/bevy-port/assets/migrated/textures/**/*.tga
!/bevy-port/assets/migrated/textures/**/*.jpg
!/bevy-port/assets/migrated/textures/**/*.jpeg

# Local Codex and graphify caches. The portable graph, report, and manifest stay
# versioned.
/.codex/hooks.json
/graphify-out/.graphify_*
/graphify-out/2026-*/
/graphify-out/authored/
/graphify-out/cache/
/graphify-out/reflections/
/graphify-out/memory/
/graphify-out/.vocab.txt
/graphify-out/graph.html
/graphify-out/cost.json
/graphify-out/query-results.jsonl
/bevy-port/graphify-out/

# IDE, OS, compiler, and crash/debug debris
/.vs/
/.idea/
*.suo
*.user
*.tmp
*.pdb
*.dmp
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc
